# remap prefix to Control + a
set -g prefix C-a
unbind C-b
bind C-a send-prefix

# mouse mode
set -g mouse on

# title
set -g set-titles on
set -g set-titles-string "#S:#I:#W" #session:window-index:window-name

# ── TokyoNight Moon palette ───────────────────────────────
# Same palette family as the Neovim colorscheme (folke/tokyonight.nvim, moon),
# but deliberately darker with a purple accent.
tn_bg="#191b29"      # bar background — darker than lualine's #1e2030
tn_bg_hl="#2f334d"   # secondary segment — darker than lualine's #3b4261
tn_accent="#c099ff"  # purple; lualine uses blue. "#82aaff" blue, "#4fd6be" teal
tn_fg="#c8d3f5"
tn_fg_dark="#828bb8"
tn_dark="#1b1d2b"    # ink on the accent block
tn_yellow="#ffc777"

# terminal capabilities
# tmux-256color (not screen-256color) so italics and LSP undercurl survive inside tmux
set -g default-terminal "tmux-256color"
set -as terminal-features ",*:RGB"
set -as terminal-overrides ',*:Smulx=\E[4::%p1%dm'
set -as terminal-overrides ',*:Setulc=\E[58::2::%p1%{65536}/%d::%p2%{256}/%d::%p3%%{256}%d%;m'
# needed for image preview (snacks.nvim) and OSC sequences from Ghostty
set -g allow-passthrough on
set -g focus-events on
set -sg escape-time 10

# panes / copy mode / messages
# NOTE: leave window-style unset. It is what lets Neovim's transparent
# background show Ghostty's blur through tmux.
set -g pane-border-style "fg=$tn_bg_hl"
set -g pane-active-border-style "fg=$tn_accent"
set -g mode-style "fg=$tn_accent,bg=$tn_bg_hl"
set -g message-style "fg=$tn_accent,bg=$tn_bg_hl,fill=$tn_bg"
set -g message-command-style "fg=$tn_accent,bg=$tn_bg_hl,fill=$tn_bg"

# status bar
set -g status-style "fg=$tn_fg_dark,bg=$tn_bg"
set -g status-justify "left"
set -g status-left-length 100
set -g status-right-length 100
set -g status-interval 5

is_keys_off="#([ $(tmux show-option -qv key-table) = 'off' ] && echo '#[fg=#ff757f]OFF ')"
# Red SYNC while synchronize-panes is on, so "typing into every pane" is never a surprise.
sync_flag="#{?pane_synchronized,#[fg=#ff757f]SYNC ,}"

set -g status-left "#[fg=$tn_dark,bg=$tn_accent,bold] #S #[fg=$tn_accent,bg=$tn_bg,nobold] "
set -g status-right "#{prefix_highlight}#[fg=$tn_fg_dark,bg=$tn_bg] $sync_flag$is_keys_off"

setw -g window-status-separator ""
setw -g window-status-style "NONE,fg=$tn_fg_dark,bg=$tn_bg"
setw -g window-status-format " #I #W#{?window_flags,#{window_flags}, } "
setw -g window-status-current-format "#[fg=$tn_accent,bg=$tn_bg_hl,bold] #I #W#{?window_flags,#{window_flags}, } "
setw -g window-status-activity-style "underscore,fg=$tn_fg_dark,bg=$tn_bg"

# force a reload of the config file
unbind r
bind r source-file ~/.tmux.conf \; display-message "Config reloaded..."

# quick pane cycling
unbind ^A
bind ^A select-pane -t :.+

# Turn off prefix
bind -T root F12  \
  set prefix None \;\
  set key-table off \;\
  if -F '#{pane_in_mode}' 'send-keys -X cancel' \;\
  refresh-client -S \;\

# Turn on prefix
bind -T off F12 \
  set -u prefix \;\
  set -u key-table \;\
  refresh-client -S

# Load remote config for remote session
if-shell 'test -n "$SSH_CLIENT"' \
   'source-file ~/.tmux.conf.remote'

# tmux-colors-solarized config
# set -g @colors-solarized 'dark'

# tmux-prefix-highlight config
set -g @prefix_highlight_output_prefix "#[fg=$tn_yellow]#[bg=$tn_bg]#[fg=$tn_dark]#[bg=$tn_yellow]"
set -g @prefix_highlight_output_suffix ""

# tmux-continuum
set -g @continuum-restore 'on'
set -g @continuum-save-interval '60'

# List of plugins
set -g @tpm_plugins '                 \
  tmux-plugins/tpm                    \
  tmux-plugins/tmux-sensible          \
  tmux-plugins/tmux-resurrect         \
  tmux-plugins/tmux-continuum         \
  tmux-plugins/tmux-prefix-highlight  \
  nhdaly/tmux-better-mouse-mode       \
'
# set -g @plugin 'seebi/tmux-colors-solarized'

# Install first: git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'
