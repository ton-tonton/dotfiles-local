# PATH configuration - add directories in order of preference
CUSTOM_PATH="/opt/homebrew/opt/postgresql@18/bin"               # PostgreSQL 18
CUSTOM_PATH="$CUSTOM_PATH:$HOME/.docker/bin"                    # Docker CLI tools
CUSTOM_PATH="$CUSTOM_PATH:$HOME/.antigravity/antigravity/bin"   # Antigravity tools
CUSTOM_PATH="$CUSTOM_PATH:$HOME/.local/bin"                     # uv tool binaries
CUSTOM_PATH="$CUSTOM_PATH:/usr/local/bin:$PATH"                 # Local binaries
export PATH="$CUSTOM_PATH"

# Don't show duplicate commands
setopt HIST_FIND_NO_DUPS

# Disable sound errors
setopt NO_BEEP

# Sort file10 after file9
setopt NUMERIC_GLOB_SORT

# Enable interactive completion menu selection
zstyle ':completion:*' menu select

# Make completion case-insensitive
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# Initialize starship
if command -v starship > /dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Initialize mise version manager if available
if command -v mise > /dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Initialize zoxide
if command -v zoxide > /dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi
