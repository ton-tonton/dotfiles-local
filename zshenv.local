# Pager
export MANROFFOPT="-c"
if command -v bat >/dev/null 2>&1; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
elif command -v batcat >/dev/null 2>&1; then
  export MANPAGER="sh -c 'col -bx | batcat -l man -p'"
fi

export EDITOR='nvim'
export VISUAL='nvim'
export PAGER='less'
export HOMEBREW_NO_ENV_HINTS=1
